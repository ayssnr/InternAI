/**
 * Generates an identifier unique within the current module instance by appending a per-prefix counter to `prefix`.
 * Counters live in module state, so ids restart on reload and are not stable across server and client renders.
 *
 * @param prefix Identifier prefix, which also selects the counter. Defaults to `'pui_id_'`.
 * @returns Identifier such as `'pui_id_1'`.
 */
declare function uuid(prefix?: string): string;

export { uuid };
